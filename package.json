{
  "name": "bordertax",
  "version": "0.1.0",
  "description": "Tax calculator for NL/BE cross-border workers",
  "keywords": [
    "belgium",
    "border-worker",
    "grensarbeider",
    "netherlands",
    "tax-calculator"
  ],
  "homepage": "https://github.com/tjorim/bordertax#readme",
  "bugs": {
    "url": "https://github.com/tjorim/bordertax/issues"
  },
  "license": "Apache-2.0",
  "author": "Jorim Tielemans <tielemans.jorim@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tjorim/bordertax.git"
  },
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "pnpm paraglide:compile && tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "pnpm paraglide:compile && tsc -b --noEmit",
    "lint": "oxlint",
    "format": "oxfmt .",
    "test": "vitest run",
    "test:ui": "vitest --ui",
    "test:watch": "vitest",
    "paraglide:compile": "paraglide-js compile --project ./project.inlang --outdir ./src/paraglide --emit-ts-declarations"
  },
  "dependencies": {
    "bootstrap": "^5.3.8",
    "bootstrap-icons": "^1.13.1",
    "react": "^19.2.0",
    "react-bootstrap": "^2.10.10",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@inlang/paraglide-js": "^2.15.0",
    "@inlang/plugin-m-function-matcher": "^2.2.3",
    "@inlang/plugin-message-format": "^4.4.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.0",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^25.5.0",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "@vitest/coverage-v8": "^4.1.0",
    "@vitest/ui": "^4.0.18",
    "happy-dom": "^20.8.8",
    "lightningcss": "^1.31.0",
    "oxfmt": "^0.41.0",
    "oxlint": "^1.56.0",
    "terser": "^5.46.1",
    "typescript": "~5.9.3",
    "vite": "^8.0.3",
    "vitest": "^4.0.18"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "packageManager": "pnpm@10.33.0"
}
