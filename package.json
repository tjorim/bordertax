{
  "name": "bordertax",
  "version": "0.1.0",
  "description": "Tax calculator for NL/BE cross-border workers",
  "keywords": [
    "belgium",
    "border-worker",
    "grensarbeider",
    "netherlands",
    "tax-calculator"
  ],
  "homepage": "https://github.com/tjorim/bordertax#readme",
  "bugs": {
    "url": "https://github.com/tjorim/bordertax/issues"
  },
  "license": "Apache-2.0",
  "author": "Jorim Tielemans <tielemans.jorim@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tjorim/bordertax.git"
  },
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "pnpm paraglide:compile && tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "pnpm paraglide:compile && tsc -b --noEmit",
    "lint": "oxlint",
    "format": "oxfmt .",
    "test": "vitest run",
    "test:ui": "vitest --ui",
    "test:watch": "vitest",
    "paraglide:compile": "paraglide-js compile --project ./project.inlang --outdir ./src/paraglide --emit-ts-declarations"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@tanstack/react-form": "^1.33.5",
    "@tanstack/react-router": "^1.170.25",
    "@tanstack/react-table": "^9.1.2",
    "bootstrap": "^5.3.8",
    "bootstrap-icons": "^1.13.1",
    "clsx": "^2.1.1",
    "react": "^19.2.8",
    "react-bootstrap": "3.0.0-beta.5",
    "react-dom": "^19.2.8",
    "react-error-boundary": "^6.1.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@inlang/paraglide-js": "^2.23.2",
    "@inlang/plugin-m-function-matcher": "^2.2.9",
    "@inlang/plugin-message-format": "^4.4.1",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^26.1.2",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "@vitest/coverage-v8": "^4.1.10",
    "@vitest/ui": "^4.1.10",
    "happy-dom": "^20.11.2",
    "lightningcss": "^1.33.0",
    "oxfmt": "^0.63.0",
    "oxlint": "^1.78.0",
    "terser": "^5.49.1",
    "typescript": "~7.0.2",
    "vite": "^8.2.1",
    "vitest": "^4.1.10"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "packageManager": "pnpm@10.33.0"
}
