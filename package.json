{
  "name": "bordertax",
  "version": "0.1.0",
  "description": "Tax calculator for NL/BE cross-border workers",
  "keywords": [
    "belgium",
    "border-worker",
    "grensarbeider",
    "netherlands",
    "tax-calculator"
  ],
  "homepage": "https://github.com/tjorim/bordertax#readme",
  "bugs": {
    "url": "https://github.com/tjorim/bordertax/issues"
  },
  "license": "Apache-2.0",
  "author": "Jorim Tielemans <tielemans.jorim@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tjorim/bordertax.git"
  },
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "pnpm paraglide:compile && tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "pnpm paraglide:compile && tsc -b --noEmit",
    "lint": "oxlint",
    "format": "oxfmt .",
    "test": "vitest run",
    "test:ui": "vitest --ui",
    "test:watch": "vitest",
    "paraglide:compile": "paraglide-js compile --project ./project.inlang --outdir ./src/paraglide --emit-ts-declarations"
  },
  "dependencies": {
    "@tanstack/react-router": "^1.169.2",
    "bootstrap": "^5.3.8",
    "bootstrap-icons": "^1.13.1",
    "react": "^19.2.6",
    "react-bootstrap": "^2.10.10",
    "react-dom": "^19.2.6"
  },
  "devDependencies": {
    "@inlang/paraglide-js": "^2.18.1",
    "@inlang/plugin-m-function-matcher": "^2.2.6",
    "@inlang/plugin-message-format": "^4.4.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.0",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^25.8.0",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.2",
    "@vitest/coverage-v8": "^4.1.6",
    "@vitest/ui": "^4.1.6",
    "happy-dom": "^20.9.0",
    "lightningcss": "^1.31.0",
    "oxfmt": "^0.50.0",
    "oxlint": "^1.65.0",
    "terser": "^5.47.1",
    "typescript": "~6.0.3",
    "vite": "^8.0.13",
    "vitest": "^4.1.6"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "packageManager": "pnpm@10.33.0"
}
