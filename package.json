{
  "name": "bordertax",
  "version": "0.1.0",
  "description": "Tax calculator for NL/BE cross-border workers",
  "keywords": [
    "belgium",
    "border-worker",
    "grensarbeider",
    "netherlands",
    "tax-calculator"
  ],
  "homepage": "https://github.com/tjorim/bordertax#readme",
  "bugs": {
    "url": "https://github.com/tjorim/bordertax/issues"
  },
  "license": "Apache-2.0",
  "author": "Jorim Tielemans <tielemans.jorim@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tjorim/bordertax.git"
  },
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "pnpm paraglide:compile && tsc -b && vite build",
    "preview": "vite preview",
    "bundle:measure": "node scripts/measure-bundle.mjs",
    "typecheck": "pnpm paraglide:compile && tsc -b --noEmit",
    "lint": "oxlint",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "test": "vitest run",
    "test:ui": "vitest --ui",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "paraglide:compile": "paraglide-js compile --project ./project.inlang --outdir ./src/paraglide --emit-ts-declarations",
    "check-message-parity": "node scripts/check-message-parity.mjs",
    "locale:audit": "node scripts/locale-audit.mjs",
    "ui:check": "node scripts/ui-maintenance.mjs check && node scripts/ui-imports.mjs",
    "ui:upstream": "node scripts/ui-maintenance.mjs upstream",
    "ui:diff": "node scripts/ui-maintenance.mjs diff",
    "ui:record": "node scripts/ui-maintenance.mjs record",
    "ui:test": "node --test scripts/ui-maintenance.verify.mjs scripts/ui-imports.verify.mjs",
    "ui:usage": "node scripts/ui-imports.mjs"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@tanstack/charts": "^1.1.0",
    "@tanstack/react-form": "2.0.0-alpha.2",
    "@tanstack/react-router": "^1.170.46",
    "@tanstack/react-table": "^9.3.1",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.0",
    "lucide-react": "^1.61.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-error-boundary": "^6.1.6",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@inlang/paraglide-js": "^2.29.1",
    "@inlang/plugin-m-function-matcher": "^2.3.4",
    "@inlang/plugin-message-format": "^4.5.4",
    "@playwright/test": "^1.64.0",
    "@shadcn/lint": "^0.2.3",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/coverage-v8": "^5.0.5",
    "@vitest/ui": "^5.0.5",
    "happy-dom": "^21.0.4",
    "lightningcss": "^1.33.0",
    "oxc-parser": "^0.155.0",
    "oxfmt": "^0.74.0",
    "oxlint": "^1.89.0",
    "shadcn": "4.22.1",
    "tailwindcss": "^4.3.3",
    "terser": "^5.51.2",
    "typescript": "~7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "packageManager": "pnpm@10.33.0"
}
